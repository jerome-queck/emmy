{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emmy:automation-reporting:1",
  "title": "Emmy automation reporting record v1",
  "description": "Version 1 structural interchange schema. The generated prepare/verify command, using actual product validators, is authoritative for UTF-8/canonical byte bounds, strict duplicate keys, time validity/order, cross-field rules, identity, privacy and URLs. Namespace ancestry and authenticated execution/publication/delivery require separate namespace history and evidence. JSON Schema alone does not prove those properties.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
    },
    "automationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
    },
    "kind": {
      "enum": [
        "automation",
        "occurrence",
        "run",
        "issue",
        "publication",
        "delivery"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "previous": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "namespace",
    "automationId",
    "kind",
    "key",
    "revision",
    "previous",
    "recordedAt",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "automation"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "enabled": {
                "type": "boolean"
              },
              "schedule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "nativeRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "freshChat": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "archiveOnSuccess": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                "format": "date-time"
              }
            },
            "required": [
              "name",
              "enabled",
              "schedule",
              "environment",
              "nativeRef",
              "model",
              "destination",
              "sourceRef",
              "freshChat",
              "archiveOnSuccess",
              "observedAt"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "occurrence"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "scheduledFor": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                "format": "date-time"
              },
              "expiresAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                "format": "date-time"
              }
            },
            "required": [
              "scheduledFor",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "occurrenceKey": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "execution": {
                "enum": [
                  "running",
                  "blocked",
                  "pending-approval",
                  "completed",
                  "failed",
                  "skipped",
                  "unknown"
                ]
              },
              "coverage": {
                "enum": [
                  "complete",
                  "partial",
                  "unavailable"
                ]
              },
              "report": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/genericReport"
                  },
                  {
                    "$ref": "#/$defs/legacyReport"
                  }
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "maxItems": 20,
                "uniqueItems": true
              },
              "timing": {
                "type": "object",
                "properties": {
                  "startedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastHeartbeatAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "observedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                    "format": "date-time"
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                },
                "required": [
                  "startedAt",
                  "lastHeartbeatAt",
                  "endedAt",
                  "observedAt",
                  "sourceRef"
                ],
                "additionalProperties": false
              },
              "telemetry": {
                "type": "object",
                "properties": {
                  "runtimeMs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inputTokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outputTokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                },
                "required": [
                  "runtimeMs",
                  "inputTokens",
                  "outputTokens",
                  "sourceRef"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "occurrenceKey",
              "execution",
              "coverage",
              "report",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "issue"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "state": {
                "enum": [
                  "open",
                  "acknowledged",
                  "resolved"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "maxItems": 20,
                "uniqueItems": true
              }
            },
            "required": [
              "title",
              "state",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "publication"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "enum": [
                  "pending",
                  "accepted",
                  "verified",
                  "failed"
                ]
              },
              "evidenceRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "subject",
              "state",
              "evidenceRef"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "delivery"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "enum": [
                  "pending",
                  "accepted",
                  "verified",
                  "failed"
                ]
              },
              "evidenceRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "subject",
              "state",
              "evidenceRef"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "previous": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "genericReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "provenance": {
          "enum": [
            "manual",
            "scheduled"
          ]
        },
        "scheduledFor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "blocked",
            "pending-approval",
            "completed",
            "failed",
            "skipped",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "sourceWindow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "type": {
          "const": "automation-outcome"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "artifactLinks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "format": "uri",
                "pattern": "^https://"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "provenance",
        "scheduledFor",
        "status",
        "coverage",
        "sourceWindow",
        "generatedAt",
        "type",
        "availability",
        "summary",
        "artifactLinks"
      ],
      "additionalProperties": false
    },
    "legacyReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "provenance": {
          "enum": [
            "manual",
            "scheduled"
          ]
        },
        "scheduledFor": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "skipped"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "sourceWindow": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
              "format": "date-time"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "maintenance",
            "suggestions",
            "token-optimisation",
            "project-chat-cleanup",
            "weekly-upkeep",
            "lifecycle-check"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1600
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "provenance",
        "scheduledFor",
        "status",
        "coverage",
        "sourceWindow",
        "generatedAt",
        "kind",
        "summary",
        "findings",
        "evidenceRefs"
      ],
      "additionalProperties": false
    }
  }
}
