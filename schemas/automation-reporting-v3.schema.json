{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emmy:automation-reporting:3",
  "title": "Emmy reporting interchange v3 with scheduled-unbound outcome v2",
  "description": "Structural union. Legacy record and control schema bytes are unchanged. Actual validators enforce clocks, exact predecessor-bound retrospective provenance and immutable terminal state. Unknown nominal slots never satisfy expectations. Old readers refuse new outcome versions; migrate readers first.",
  "oneOf": [
    {
      "$ref": "automation-reporting-v2.schema.json"
    },
    {
      "$ref": "#/$defs/unboundRun"
    }
  ],
  "$defs": {
    "unboundRun": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
        },
        "automationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
        },
        "kind": {
          "const": "run"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "namespace",
        "automationId",
        "kind",
        "key",
        "revision",
        "previous",
        "recordedAt",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "run"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "occurrenceKey": {
                    "type": "null"
                  },
                  "execution": {
                    "enum": [
                      "running",
                      "blocked",
                      "pending-approval",
                      "completed",
                      "failed",
                      "skipped",
                      "unknown"
                    ]
                  },
                  "coverage": {
                    "enum": [
                      "complete",
                      "partial",
                      "unavailable"
                    ]
                  },
                  "report": {
                    "$ref": "#/$defs/unboundReport"
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "maxItems": 20,
                    "uniqueItems": true
                  },
                  "timing": {
                    "type": "object",
                    "properties": {
                      "startedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lastHeartbeatAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "endedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "observedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                        "format": "date-time"
                      },
                      "sourceRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "required": [
                      "startedAt",
                      "lastHeartbeatAt",
                      "endedAt",
                      "observedAt",
                      "sourceRef"
                    ],
                    "additionalProperties": false
                  },
                  "telemetry": {
                    "type": "object",
                    "properties": {
                      "runtimeMs": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "inputTokens": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "outputTokens": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sourceRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "required": [
                      "runtimeMs",
                      "inputTokens",
                      "outputTokens",
                      "sourceRef"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "occurrenceKey",
                  "execution",
                  "coverage",
                  "report",
                  "evidenceRefs"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "previous": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "unboundReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "provenance": {
          "const": "scheduled-unbound"
        },
        "scheduledFor": {
          "type": "null"
        },
        "status": {
          "enum": [
            "running",
            "blocked",
            "pending-approval",
            "completed",
            "failed",
            "skipped",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "sourceWindow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "type": {
          "const": "automation-outcome"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "artifactLinks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "format": "uri",
                "pattern": "^https://"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "sourceEvidence": {
          "type": "object",
          "properties": {
            "observedAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                }
              ]
            },
            "recordedAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                  "format": "date-time"
                }
              ]
            }
          },
          "required": [
            "observedAt",
            "recordedAt"
          ],
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "producer",
                "retrospective"
              ]
            },
            "attestedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "basedOn": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          },
          "required": [
            "mode",
            "attestedBy",
            "basedOn"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "provenance",
        "scheduledFor",
        "status",
        "coverage",
        "sourceWindow",
        "generatedAt",
        "type",
        "availability",
        "summary",
        "artifactLinks",
        "sourceEvidence",
        "generation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "generation": {
                "properties": {
                  "mode": {
                    "const": "producer"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "generation": {
                "properties": {
                  "basedOn": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "generation": {
                "properties": {
                  "basedOn": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "sourceEvidence": {
                "properties": {
                  "recordedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
