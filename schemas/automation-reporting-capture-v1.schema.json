{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation-reporting-capture-v1.schema.json",
  "description": "Structural shape only. Runtime also validates exact raw bytes, identities, pins, pagination, aggregate bounds and complete history.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "inventory",
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "automation-reporting-capture"
    },
    "inventory": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "root",
            "namespaces"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "pages"
            },
            "root": {
              "type": "object",
              "required": [
                "folderId",
                "generation",
                "beforeGeneration",
                "afterGeneration",
                "totalEntries",
                "totalPages",
                "pages",
                "mechanism",
                "evidenceRef"
              ],
              "additionalProperties": false,
              "properties": {
                "folderId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "generation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "beforeGeneration": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "afterGeneration": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "totalEntries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5000
                },
                "totalPages": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "generation",
                      "cursor",
                      "nextCursor",
                      "eof",
                      "entries"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "generation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "cursor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "nextCursor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "eof": {
                        "type": "boolean"
                      },
                      "entries": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "name",
                            "parentId",
                            "type"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 400,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            },
                            "name": {
                              "type": "string",
                              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                            },
                            "parentId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 400,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            },
                            "type": {
                              "const": "folder"
                            }
                          }
                        },
                        "maxItems": 5000
                      }
                    }
                  },
                  "maxItems": 1000
                },
                "mechanism": {
                  "const": "snapshot-cursor"
                },
                "evidenceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "namespace",
                  "listing"
                ],
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                  },
                  "listing": {
                    "type": "object",
                    "required": [
                      "folderId",
                      "generation",
                      "beforeGeneration",
                      "afterGeneration",
                      "totalEntries",
                      "totalPages",
                      "pages",
                      "mechanism",
                      "evidenceRef"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "folderId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "generation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "beforeGeneration": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "afterGeneration": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "totalEntries": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      "totalPages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "pages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "generation",
                            "cursor",
                            "nextCursor",
                            "eof",
                            "entries"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "generation": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 400,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            },
                            "cursor": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 400,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "nextCursor": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 400,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "eof": {
                              "type": "boolean"
                            },
                            "entries": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "name",
                                  "parentId",
                                  "type",
                                  "size",
                                  "sha256"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 400,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "name": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}\\.json$"
                                  },
                                  "parentId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 400,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "type": {
                                    "const": "file"
                                  },
                                  "size": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 32769
                                  },
                                  "sha256": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}$"
                                  }
                                }
                              },
                              "maxItems": 5000
                            }
                          }
                        },
                        "maxItems": 1000
                      },
                      "mechanism": {
                        "const": "snapshot-cursor"
                      },
                      "evidenceRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  }
                }
              },
              "maxItems": 200
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "id",
            "bytesBase64"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "pinned"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "bytesBase64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "bytesBase64"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "bytesBase64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      },
      "maxItems": 5000
    }
  }
}
