{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation-reporting-discovery-scope-v2.schema.json",
  "description": "Approved scope; runtime enforces disjoint namespaces, one registered owner per exact anchor, inventory and anchors outside Records, and metadata before raw acquisition.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "recordScope",
    "owners"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "automation-reporting-discovery-scope"
    },
    "recordScope": {
      "$ref": "automation-reporting-read-scope-v1.schema.json"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "anchor",
          "inventoryParentId",
          "namespaces",
          "singleWriter"
        ],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
          },
          "anchor": {
            "type": "object",
            "required": [
              "id",
              "parentId",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "parentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          "inventoryParentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "singleWriter": {
            "const": true
          }
        }
      }
    }
  }
}
