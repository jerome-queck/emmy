{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emmy:automation-reporting:2",
  "title": "Emmy reporting control v2 with legacy producer v1",
  "description": "Structural schema only. Caller-configured registration control, source clocks, exact schedule projection and complete lineage are enforced by actual product code. Observation grace and source freshness never imply execution failure.",
  "oneOf": [
    {
      "$ref": "automation-reporting-v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
        },
        "automationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
        },
        "kind": {
          "enum": [
            "registration",
            "expectation"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "namespace",
        "automationId",
        "kind",
        "key",
        "revision",
        "previous",
        "recordedAt",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "registration"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "actor": {
                    "const": "registration-control"
                  },
                  "targetNamespace": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                  },
                  "targetAutomationId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                  },
                  "nativeRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "rrule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "dtstart": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "timezoneSource": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "sourceKind": {
                    "enum": [
                      "native-definition",
                      "cloud-definition",
                      "owner-explicit"
                    ]
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "observedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                    "format": "date-time"
                  },
                  "effectiveAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                    "format": "date-time"
                  },
                  "observationGraceSeconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 604800
                  },
                  "sourceMaxAgeSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 604800
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "actor",
                  "targetNamespace",
                  "targetAutomationId",
                  "nativeRef",
                  "enabled",
                  "rrule",
                  "dtstart",
                  "timezone",
                  "timezoneSource",
                  "sourceKind",
                  "sourceRef",
                  "observedAt",
                  "effectiveAt",
                  "observationGraceSeconds",
                  "sourceMaxAgeSeconds",
                  "fingerprint"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "expectation"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "actor": {
                    "const": "registration-control"
                  },
                  "registration": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "targetNamespace": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                  },
                  "targetAutomationId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,119}$"
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "scheduledFor": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                    "format": "date-time"
                  },
                  "observationDueAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$",
                    "format": "date-time"
                  }
                },
                "required": [
                  "actor",
                  "registration",
                  "targetNamespace",
                  "targetAutomationId",
                  "fingerprint",
                  "scheduledFor",
                  "observationDueAt"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  ]
}
